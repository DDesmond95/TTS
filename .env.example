# === OmniVoice Studio Environment Configuration ===

# --- Docker & Registry ---
DOCKER_REGISTRY=docker.io
DOCKER_USERNAME=omnivoice
IMAGE_API=omnivoice-studio-api
IMAGE_UI=omnivoice-studio-ui
IMAGE_TAG=latest

# --- Paths (relative to app root) ---
MODELS_DIR=./models
VOICES_DIR=./voices
OUTPUTS_DIR=./outputs
CONFIGS_DIR=./configs

# --- Engine Runtime ---
DEVICE=cuda:0
DTYPE=float16
MAX_CONCURRENT_JOBS=1
MODEL_CACHE_SIZE=1

# --- API Settings ---
API_HOST=0.0.0.0
API_PORT=8001
API_KEY=change-me-in-production

# --- UI Settings ---
UI_HOST=0.0.0.0
UI_PORT=7860
UI_MODE=local_engine
API_URL=http://localhost:8001
